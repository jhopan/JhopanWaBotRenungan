# ===================================
# WhatsApp Bot Renungan Harian v3.0
# ===================================

# -----------------
# Telegram Bot
# -----------------
# Token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=

# -----------------
# AI Provider (Gemini)
# -----------------
# Pilih AI provider yang digunakan
AI_PROVIDER=gemini

# Gemini API Key (gratis dari https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Model Gemini yang digunakan
AI_MODEL=gemini-1.5-flash

# -----------------
# Google Sheets (Opsional - untuk ulang tahun)
# -----------------
# Path ke file credentials.json service account
GOOGLE_SERVICE_ACCOUNT=./credentials.json

# ID Google Spreadsheet untuk data ulang tahun
SPREADSHEET_ID=

# -----------------
# WhatsApp Configuration
# -----------------
# Group ID WhatsApp untuk renungan harian
# Format: 120363123456789@g.us (untuk grup)
# atau 6281234567890@c.us (untuk personal)
RENUNGAN_GROUP_ID=

# Group ID WhatsApp untuk ucapan ulang tahun
BIRTHDAY_GROUP_ID=

# -----------------
# Schedule
# -----------------
# Waktu kirim renungan (format 24 jam: HH:mm)
RENUNGAN_TIME=08:00

# Waktu cek ulang tahun (format 24 jam: HH:mm)
BIRTHDAY_TIME=07:00

# Timezone
TIMEZONE=Asia/Makassar
