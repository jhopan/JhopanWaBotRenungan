# ============================================
# BOT CONFIGURATION  
# ============================================
TELEGRAM_BOT_TOKEN=

# ============================================
# AI CONFIGURATION - Gemini 2.5 Flash-Lite
# ============================================
# Limit: 15 req/min, 1000 req/day, 250k token/min
# Multiple API keys (comma-separated): auto-rotate sebelum limit
# Example: key1,key2,key3 (akan switch otomatis saat usage ≥ 13/15)
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash-lite

# OpenRouter API (optional, untuk fallback)
OPENROUTER_API_KEY=

# ============================================
# GOOGLE SHEETS CONFIGURATION
# ============================================
GOOGLE_SERVICE_ACCOUNT=./credentials.json
# Sheet untuk data ulang tahun (Nama, Tanggal, ChatID)
BIRTHDAY_SPREADSHEET_ID=
BIRTHDAY_SHEET_NAME=Sheet1
# Range kolom: A=Nama, B=Tanggal (DD-MM), C=ChatID
BIRTHDAY_RANGE=A:C

# ============================================
# TIMEZONE & SCHEDULE
# ============================================
TIMEZONE=Asia/Makassar
RENUNGAN_TIME=08:00
BIRTHDAY_TIME=07:00

# ============================================
# WHATSAPP TARGET GROUPS
# ============================================
# ID grup untuk renungan harian (kosongkan jika belum ada, atur via Telegram)
RENUNGAN_GROUP_ID=
# ID grup untuk ucapan ulang tahun (kosongkan jika kirim personal)
BIRTHDAY_GROUP_ID=

# ============================================
# ADMIN CONFIGURATION
# ============================================
# Admin Telegram User IDs (pisahkan dengan koma jika lebih dari 1)
ADMIN_TELEGRAM_IDS=
