{
  "name": "whatsapp-telegram-renungan-bot",
  "version": "5.2.0",
  "description": "Bot WhatsApp & Telegram untuk Renungan Harian dengan AI - Webhook Mode untuk GCP Free Tier",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "start:gc": "node --expose-gc --max-old-space-size=480 src/index.js",
    "start:prod": "node --expose-gc --max-old-space-size=480 --optimize-for-size src/index.js",
    "dev": "node --watch src/index.js",
    "tunnel": "cloudflared tunnel --url http://localhost:3000"
  },
  "keywords": [
    "whatsapp",
    "telegram",
    "bot",
    "renungan",
    "devotion",
    "ai",
    "webhook",
    "gcp-free-tier"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "fs-extra": "^11.2.0",
    "moment-timezone": "^0.5.45",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.66.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
